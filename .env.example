# Your Zuse API key. Get one at https://bineric.com/platform:
# sign up, open "API keys" in the dashboard and click "Generate Key".
# Copy this file to .env and paste the key after the = sign. .env is never committed.
BINERIC_API_KEY=paste-your-key-here

# Optional
# ZUSE_MODEL=zuse-27b
# BINERIC_BASE_URL=https://api.bineric.com

# Optional, only to compare with Claude in the benchmarks (--claude)
# ANTHROPIC_API_KEY=
